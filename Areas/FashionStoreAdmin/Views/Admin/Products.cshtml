@model FashionStoreAdmin.Models.ProductManagementViewModel
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var categories = Model.Categories;
    var brands = Model.Brands;
    var collections = Model.Collections;
}

<h1 class="h3 mb-3">Quản lý sản phẩm</h1>

<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><strong>Thêm sản phẩm mới</strong></div>
            <div class="card-body">
                <form asp-action="AddProduct" method="post" enctype="multipart/form-data" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label class="form-label">Tên sản phẩm</label>
                        <input name="Name" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mô tả</label>
                        <input name="Description" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Danh mục</label>
                        <select name="CategoryId" class="form-select" required>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Thương hiệu</label>
                        <select name="BrandId" class="form-select">
                            @foreach (var brand in brands)
                            {
                                <option value="@brand.Id">@brand.Name</option>
                            }
                        </select>
                    </div>
                    @* <div class="col-md-2">
                        <label class="form-label">Bộ sưu tập</label>
                        <select name="CollectionId" class="form-select">
                            @foreach (var collection in collections)
                            {
                                <option value="@collection.Id">@collection.Name</option>
                            }
                        </select>
                    </div> *@
                    <div class="col-md-2">
                        <label class="form-label">Giá gốc</label>
                        <input type="number" min="0" name="OriginalPrice" class="form-control" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Giá bán</label>
                        <input type="number" min="0" name="Price" class="form-control" required />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Tồn</label>
                        <input type="number" min="0" name="Stock" class="form-control" required />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">Size</label>
                        <input name="Size" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Màu</label>
                        <input name="Color" class="form-control" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Kích hoạt</label>
                        <select name="IsActive" class="form-select">
                            <option value="true">Có</option>
                            <option value="false">Không</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <label class="form-label">&nbsp;</label>
                        <button class="btn btn-primary" type="submit">Thêm sản phẩm</button>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Ảnh sản phẩm (nhiều ảnh)</label>
                        <input class="form-control" type="file" name="imageFiles" accept=".jpg,.jpeg,.png,.webp" multiple />
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        @* <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white"><strong>Thêm sản phẩm (Size/Màu)</strong></div>
            <div class="card-body">
                <form asp-action="AddVariant" method="post" class="row g-2">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Sản phẩm</label>
                        <select class="form-select" name="productId" required>
                            @foreach (var p in Model.Products)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Size</label>
                        <input class="form-control" name="size" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Màu</label>
                        <input class="form-control" name="color" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Giá</label>
                        <input type="number" min="0" class="form-control" name="price" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Tồn kho</label>
                        <input type="number" min="0" class="form-control" name="stock" required />
                    </div>
                    <div class="col-12 d-grid">
                        <button class="btn btn-dark" type="submit">Thêm sản phẩm</button>
                    </div>
                </form>
            </div>
        </div> *@
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><strong>Thêm hình ảnh (Gallery)</strong></div>
            <div class="card-body">
                <form asp-action="AddImage" method="post">
                    @Html.AntiForgeryToken()
                    <label class="form-label">Sản phẩm</label>
                    <select class="form-select mb-2" name="productId" required>
                        @foreach (var p in Model.Products)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                    <label class="form-label">URL hình ảnh</label>
                    <input class="form-control mb-2" name="imageUrl" placeholder="https://..." required />
                    <label class="form-label">Chú thích</label>
                    <input class="form-control mb-3" name="caption" />
                    <button class="btn btn-secondary w-100" type="submit">Thêm ảnh</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center gap-2 mb-3">

    <!-- bên trái -->
    <div class="d-flex gap-2 flex-grow-1">

        <!-- hành động -->
        <div class="dropdown">

            <button
                class="btn btn-primary dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown">

                Hành động

            </button>

            <ul class="dropdown-menu shadow">

                <li>
                    <button
                        class="dropdown-item"
                        type="button"
                        onclick="copySelectedProducts()">

                        📋 Sao chép sản phẩm đã chọn

                    </button>
                </li>

                <li>
                    <button
                        class="dropdown-item text-danger"
                        type="button"
                        onclick="deleteSelectedProducts()">

                        🗑️ Xóa sản phẩm đã chọn

                    </button>
                </li>

            </ul>

        </div>

        <!-- tìm kiếm -->
        <form method="get" class="flex-grow-1">

            <div class="input-group">

                <input
                    type="text"
                    name="keyword"
                    class="form-control"
                    placeholder="Tìm tên, mô tả..."
                    value="@Model.Keyword" />

                <button class="btn btn-primary">
                    Tìm kiếm
                </button>

            </div>

        </form>

    </div>

    <!-- cấu hình cột -->
    <div class="dropdown">

        <button
            class="btn btn-outline-secondary dropdown-toggle"
            type="button"
            data-bs-toggle="dropdown">

            ⚙️ Cấu hình cột

        </button>

        <ul class="dropdown-menu dropdown-menu-end shadow p-2">

            <li>
                <label class="dropdown-item">
                    <input
                        type="checkbox"
                        class="form-check-input me-2 column-toggle"
                        data-column="col-description"
                        checked>

                    Mô tả
                </label>
            </li>

            <li>
                <label class="dropdown-item">
                    <input
                        type="checkbox"
                        class="form-check-input me-2 column-toggle"
                        data-column="col-brand"
                        checked>

                    Thương hiệu
                </label>
            </li>

            <li>
                <label class="dropdown-item">
                    <input
                        type="checkbox"
                        class="form-check-input me-2 column-toggle"
                        data-column="col-stock"
                        checked>

                    Tồn kho
                </label>
            </li>

        </ul>

    </div>

</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>
                        <input type="checkbox" id="check-all" />
                    </th>
                    <th>ID</th>
                    <th>Tên</th>
                    <th class="col-description">
                        Mô tả
                    </th>

                    <th>Danh mục</th>
                    <th class="col-brand">
                        Thương hiệu
                    </th>
                    
                    <th>Giá gốc</th>
                    <th>Giá</th>
                    <th class="col-stock">
                        Tồn kho
                    </th>

                    <th>Gallery</th>
                    <th>Kích hoạt</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Products)
            {
                var categoryName = categories.FirstOrDefault(c => c.Id == item.CategoryId)?.Name ?? "Không rõ";
                var brandName = brands.FirstOrDefault(c => c.Id == item.BrandId)?.Name ?? "-";
                var collectionName = collections.FirstOrDefault(c => c.Id == item.CollectionId)?.Name ?? "-";
                
                var imageCount = Model.Images.Count(i => i.ProductId == item.Id);
                <tr>
                    <td>
                        <!--sao chép thông tin-->
                        <input
                            type="checkbox"
                            class="product-checkbox"
                            value="@item.Id"

                            data-id="@item.Id"
                            data-name="@item.Name"
                            data-description="@item.Description"
                            data-category="@categoryName"
                            data-brand="@brandName"
                            data-originalprice="@item.OriginalPrice"
                            data-price="@item.Price"
                            data-stock="@item.Stock"
                            data-size="@item.Size"
                            data-color="@item.Color"
                            data-active="@(item.IsActive ? "Có" : "Không")" />
                    </td>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td class="col-description">
                        @item.Description
                    </td>
                    <td>@categoryName</td>
                    <td class="col-brand">
                        @brandName
                    </td>
                   
                    <td>@item.OriginalPrice.ToString("N0") VND</td>
                    <td>@item.Price.ToString("N0") VND</td>
                    <td class="col-stock">
                        @item.Stock
                    </td>  
                    <td>@imageCount ảnh</td>
                    <td>@(item.IsActive ? "Có" : "Không")</td>
                    <td class="d-flex gap-1 flex-wrap">

                        <!--chi tiết-->
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-info btn-view-product"
                            data-bs-toggle="modal"
                            data-bs-target="#viewProductModal"

                            data-id="@item.Id"
                            data-name="@item.Name"
                            data-description="@item.Description"
                            data-category="@categoryName"
                            data-brand="@brandName"
                            data-originalprice="@item.OriginalPrice.ToString("N0")"
                            data-price="@item.Price.ToString("N0")"
                            data-stock="@item.Stock"
                            data-size="@item.Size"
                            data-color="@item.Color"
                            data-isactive="@(item.IsActive ? "Có" : "Không")">

                            Chi tiết
                        </button>
                        <!--sửa-->
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-primary btn-edit-product"
                            data-bs-toggle="modal"
                            data-bs-target="#editProductModal"
                            data-id="@item.Id"
                            data-name="@item.Name"
                            data-description="@item.Description"
                            data-categoryid="@item.CategoryId"
                            data-brandid="@item.BrandId"
                            data-originalprice="@item.OriginalPrice"
                            data-price="@item.Price"
                            data-stock="@item.Stock"
                            data-size="@item.Size"
                            data-color="@item.Color"
                            data-isactive="@item.IsActive">
                            Sửa
                        </button>

                        <!--copy-->
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-secondary"
                            onclick="copySingleProduct(this)"

                            data-id="@item.Id"
                            data-name="@item.Name"
                            data-description="@item.Description"
                            data-category="@categoryName"
                            data-brand="@brandName"
                            data-originalprice="@item.OriginalPrice.ToString("N0")"
                            data-price="@item.Price.ToString("N0")"
                            data-stock="@item.Stock"
                            data-size="@item.Size"
                            data-color="@item.Color"
                            data-active="@(item.IsActive ? "Có" : "Không")">

                            Copy
                        </button>
                        <form asp-action="DeleteProduct" method="post" onsubmit="return confirm('Xóa sản phẩm này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@* phân trang *@
<div class="d-flex align-items-center gap-2 mt-3">

    @* nút lùi *@
    <a class="btn btn-sm btn-outline-secondary
       @(Model.CurrentPage == 1 ? "disabled" : "")"

       href="?page=@(Model.CurrentPage - 1)&keyword=@Model.Keyword">

        <
    </a>

    @* trang hiện tại *@
    <span class="btn btn-sm btn-primary rounded-pill px-3">
        @Model.CurrentPage
    </span>

    @* nút tới *@
    <a class="btn btn-sm btn-outline-secondary
       @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"

       href="?page=@(Model.CurrentPage + 1)&keyword=@Model.Keyword">

        >
    </a>

    @* tổng số trang *@
    <span class="btn btn-sm btn-outline-secondary">
        @Model.TotalPages Trang
    </span>

</div>




<div class="modal fade" id="editProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="UpdateProduct" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Sửa sản phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="edit-id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Tên sản phẩm</label>
                            <input class="form-control" name="Name" id="edit-name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Mô tả</label>
                            <input class="form-control" name="Description" id="edit-description" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Danh mục</label>
                            <select class="form-select" name="CategoryId" id="edit-category">
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Thương hiệu</label>
                            <select class="form-select" name="BrandId" id="edit-brand">
                                @foreach (var brand in brands)
                                {
                                    <option value="@brand.Id">@brand.Name</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-3">
                            <label class="form-label">Giá gốc</label>
                            <input type="number" min="0" class="form-control" name="OriginalPrice" id="edit-original-price" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Giá bán</label>
                            <input type="number" min="0" class="form-control" name="Price" id="edit-price" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Số lượng</label>
                            <input type="number" min="0" class="form-control" name="Stock" id="edit-stock" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Size</label>
                            <input class="form-control" name="Size" id="edit-size" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Màu sắc</label>
                            <input class="form-control" name="Color" id="edit-color" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Kích hoạt</label>
                            <select class="form-select" name="IsActive" id="edit-is-active">
                                <option value="true">Có</option>
                                <option value="false">Không</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Upload thêm ảnh (nhiều ảnh)</label>
                            <input type="file" class="form-control" name="imageFiles" accept=".jpg,.jpeg,.png,.webp" multiple />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* chi tiết sản phẩm *@
<div class="modal fade"
     id="viewProductModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Chi tiết sản phẩm
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <table class="table table-bordered">

                    <tr>
                        <th>ID</th>
                        <td id="view-id"></td>
                    </tr>

                    <tr>
                        <th>Tên sản phẩm</th>
                        <td id="view-name"></td>
                    </tr>

                    <tr>
                        <th>Mô tả</th>
                        <td id="view-description"></td>
                    </tr>

                    <tr>
                        <th>Danh mục</th>
                        <td id="view-category"></td>
                    </tr>

                    <tr>
                        <th>Thương hiệu</th>
                        <td id="view-brand"></td>
                    </tr>

                    <tr>
                        <th>Giá gốc</th>
                        <td id="view-originalprice"></td>
                    </tr>

                    <tr>
                        <th>Giá bán</th>
                        <td id="view-price"></td>
                    </tr>

                    <tr>
                        <th>Tồn kho</th>
                        <td id="view-stock"></td>
                    </tr>

                    <tr>
                        <th>Size</th>
                        <td id="view-size"></td>
                    </tr>

                    <tr>
                        <th>Màu sắc</th>
                        <td id="view-color"></td>
                    </tr>

                    <tr>
                        <th>Kích hoạt</th>
                        <td id="view-active"></td>
                    </tr>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        (() => {
            const editButtons = document.querySelectorAll('.btn-edit-product');
            for (const btn of editButtons) {
                btn.addEventListener('click', () => {
                    document.getElementById('edit-id').value = btn.dataset.id || '';
                    document.getElementById('edit-name').value = btn.dataset.name || '';
                    document.getElementById('edit-description').value = btn.dataset.description || '';
                    document.getElementById('edit-category').value = btn.dataset.categoryid || '';
                    document.getElementById('edit-brand').value = btn.dataset.brandid || '';
                    @* document.getElementById('edit-collection').value = btn.dataset.collectionid || ''; *@
                    document.getElementById('edit-original-price').value = btn.dataset.originalprice || '0';
                    document.getElementById('edit-price').value = btn.dataset.price || '0';
                    document.getElementById('edit-stock').value = btn.dataset.stock || '0';
                    document.getElementById('edit-size').value = btn.dataset.size || '';
                    document.getElementById('edit-color').value = btn.dataset.color || '';
                    document.getElementById('edit-is-active').value = (btn.dataset.isactive || 'true').toLowerCase();
                });
            }
        })();

        //chi tiết sản phẩm
        const viewButtons =
            document.querySelectorAll('.btn-view-product');

        for (const btn of viewButtons) {

            btn.addEventListener('click', () => {

                document.getElementById('view-id').innerText =
                    btn.dataset.id || '';

                document.getElementById('view-name').innerText =
                    btn.dataset.name || '';

                document.getElementById('view-description').innerText =
                    btn.dataset.description || '';

                document.getElementById('view-category').innerText =
                    btn.dataset.category || '';

                document.getElementById('view-brand').innerText =
                    btn.dataset.brand || '';

                document.getElementById('view-originalprice').innerText =
                    btn.dataset.originalprice + ' VND';

                document.getElementById('view-price').innerText =
                    btn.dataset.price + ' VND';

                document.getElementById('view-stock').innerText =
                    btn.dataset.stock || '';

                document.getElementById('view-size').innerText =
                    btn.dataset.size || '';

                document.getElementById('view-color').innerText =
                    btn.dataset.color || '';

                document.getElementById('view-active').innerText =
                    btn.dataset.isactive || '';
            });

        }

        //check all
        const checkAll = document.getElementById('check-all');

        if (checkAll) {

            checkAll.addEventListener('change', function () {

                const checkboxes =
                    document.querySelectorAll('.product-checkbox');

                checkboxes.forEach(x => {
                    x.checked = this.checked;
                });

            });

        }

        //ẩn hiện cột
        const toggles =
                document.querySelectorAll('.column-toggle');

            toggles.forEach(toggle => {

                toggle.addEventListener('change', function () {

                    const column =
                        this.dataset.column;

                    const elements =
                        document.querySelectorAll('.' + column);

                    elements.forEach(el => {

                        el.style.display =
                            this.checked
                                ? ''
                                : 'none';

                    });

                });

            });

        // copy nhiều sản phẩm
        function copySelectedProducts() {

            const checked =
                document.querySelectorAll(
                    '.product-checkbox:checked'
                );

            if (checked.length === 0) {

                alert('Chưa chọn sản phẩm');
                return;
            }

            let text = '';

            checked.forEach(x => {

                const row =
                    x.closest('tr');

                const cells =
                    row.querySelectorAll('td');

                text +=
                    'ID: ' + cells[1].innerText + '\n' +
                    'Tên: ' + cells[2].innerText + '\n' +
                    'Mô tả: ' + cells[3].innerText + '\n' +
                    'Danh mục: ' + cells[4].innerText + '\n' +
                    'Thương hiệu: ' + cells[5].innerText + '\n' +
                    'Giá gốc: ' + cells[6].innerText + '\n' +
                    'Giá bán: ' + cells[7].innerText + '\n' +
                    'Tồn kho: ' + cells[8].innerText + '\n' +
                    'Gallery: ' + cells[9].innerText + '\n' +
                    'Kích hoạt: ' + cells[10].innerText + '\n';

                text +=
                    '-------------------------\n';

            });

            navigator.clipboard.writeText(text);

            alert('Đã sao chép thông tin sản phẩm');

        }

        function copySingleProduct(btn) {

            let text =
                'ID: ' + btn.dataset.id + '\n' +
                'Tên: ' + btn.dataset.name + '\n' +
                'Mô tả: ' + btn.dataset.description + '\n' +
                'Danh mục: ' + btn.dataset.category + '\n' +
                'Thương hiệu: ' + btn.dataset.brand + '\n' +
                'Giá gốc: ' + btn.dataset.originalprice + ' VND\n' +
                'Giá bán: ' + btn.dataset.price + ' VND\n' +
                'Tồn kho: ' + btn.dataset.stock + '\n' +
                'Size: ' + btn.dataset.size + '\n' +
                'Màu: ' + btn.dataset.color + '\n' +
                'Kích hoạt: ' + btn.dataset.active;

            navigator.clipboard.writeText(text);

            alert('Đã sao chép sản phẩm');
        }

        // xóa nhiều sản phẩm
        function deleteSelectedProducts() {

            const checked =
                document.querySelectorAll(
                    '.product-checkbox:checked'
                );

            if (checked.length === 0) {

                alert('Chưa chọn sản phẩm');
                return;
            }

            if (!confirm('Xóa các sản phẩm đã chọn?')) {
                return;
            }

            let ids = [];

            checked.forEach(x => {
                ids.push(x.value);
            });

            fetch('/Admin/DeleteMultipleProducts', {

                method: 'POST',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(ids)

            })
            .then(res => {

                if (res.ok) {

                    alert('Đã xóa');

                    location.reload();
                }
                else {

                    alert('Xóa thất bại');
                }

            });

        }
    </script>

    
}
